# RETAINAI Frontend — Production Environment Example
# Copy to .env.production (local) or set as Environment Variables in Vercel dashboard.
# Vercel: Project Settings → Environment Variables → Add VITE_API_BASE_URL
# Must point to the live Render backend. Do NOT commit real secrets.

# ── Required ──────────────────────────────────────────────────────────────
# Live Render backend — hybrid-live-dynamic branch
VITE_API_BASE_URL=https://retainai-api-live.onrender.com/api/v1

# ── Optional overrides ────────────────────────────────────────────────────
# VITE_APP_NAME=RETAINAI
# VITE_DEMO_MODE=true
# VITE_TENANT_ID=demo-tenant-001

# ── Handling in code ──────────────────────────────────────────────────────
# frontend/src/services/api.ts reads:
#   export const API_BASE_URL = import.meta.env.VITE_API_BASE_URL || 'http://localhost:8000/api/v1';
# - Vite inlines VITE_* vars at build time (npm run build). Ensure Vercel env is set BEFORE build.
# - SPA fallback is handled by vercel.json rewrites: { "source": "/(.*)", "destination": "/index.html" }
# - CORS: backend render.yaml must list your Vercel origin in CORS_ORIGINS
#   e.g. https://retainai-rescue-agent.vercel.app,http://localhost:5173
# - Local preview: VITE_API_BASE_URL=http://localhost:8000/api/v1 npm run dev (Vite proxy /api → localhost:8000)
