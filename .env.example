# RETAINAI - Environment Configuration

# Application
APP_NAME=RETAINAI
APP_ENV=development
DEBUG=true
PORT=8000

# Database Configuration (PostgreSQL / SQLite fallback for development)
DATABASE_URL=sqlite:///./retainai.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/retainai

# LLM / AI Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_llm_api_key_here

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Application Settings
DEMO_MODE=true
LOG_LEVEL=INFO
