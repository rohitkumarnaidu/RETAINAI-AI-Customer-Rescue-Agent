# RETAINAI - Environment Configuration

# Application
APP_NAME=RETAINAI
APP_ENV=development
DEBUG=true
PORT=8000

# Database Configuration (PostgreSQL / SQLite fallback for development)
DATABASE_URL=sqlite+aiosqlite:///./retainai.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/retainai

# LLM / AI Configuration — Groq production Aug 2026 (Llama deprecated 16 Aug 2026)
# Current Groq production: openai/gpt-oss-120b ~500tps $0.15/$0.60 (flagship) | openai/gpt-oss-20b ~1000tps $0.075/$0.30 (fastest)
# Legacy llama-3.3-70b/llama-3.1-8b shut down 16 Aug 2026 — Groq recommends gpt-oss-120b/20b
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Alternatives: openai/gpt-oss-20b (fastest) | groq/compound (agentic tools) | whisper-large-v3 (audio)
# For OpenAI direct: LLM_PROVIDER=openai, LLM_MODEL=gpt-4o, OPENAI_API_KEY=sk_...
# For Gemini: LLM_PROVIDER=gemini, LLM_MODEL=gemini-2.5-pro
LLM_API_KEY=your_llm_api_key_here  # or GROQ_API_KEY=gsk_... or OPENAI_API_KEY=sk_...
# GROQ_API_KEY=gsk_your_groq_key_here
# OPENAI_API_KEY=sk_your_openai_key_here

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Application Settings
DEMO_MODE=true
LOG_LEVEL=INFO

# Auth (S39) — DEMO_MODE=true bypasses unless AUTH_ENABLED=true
# ── Phase 5 Prod Hardening ──────────────────────────────────────────────
# PROD-LIKE defaults (recommended for any deploy beyond local demo):
#   AUTH_ENABLED=true    # enforce JWT HS256 (auth/auth.py) — prod must be true
#   DEMO_MODE=false      # disable DEMO_BYPASS; require real JWT/API key
# DEMO/HACKATHON override (local reliability without JWT):
#   AUTH_ENABLED=false
#   DEMO_MODE=true
# docker-compose.yml already sets AUTH_ENABLED=true / DEMO_MODE=false prod-like;
# override via .env or docker-compose.override.yml for demo as noted in docker-compose top comment.
# All below are 32-char demo values (hex), safe for hackathon — REPLACE IN PROD
AUTH_ENABLED=false  # demo default; PROD MUST set true (see prod-like block above + docker-compose.yml)
AUTH_SECRET=changeme-replace-in-prod-32char-aaaa
JWT_SECRET=changeme-replace-in-prod-32char-aaaa
APP_SECRET_KEY=changeme-replace-in-prod-32char-bbbb
DEMO_API_KEY=changeme-replace-in-prod-32char-cccc
API_KEY=changeme-replace-in-prod-32char-cccc
DEMO_TENANT_ID=changeme-tenant-id-replace-in-prod
DEMO_ORG_KEY=changeme-org-key-replace-in-prod

# ChromaDB Memory (replaces Redis for semantic memory)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_API_KEY=changeme-chroma-key-replace-in-prod
CHROMA_TENANT=changeme-chroma-tenant-replace-prod
CORS_SECRET=changeme-cors-secret-replace-prod

# Timeouts
AGENT_TIMEOUT=60
LLM_TIMEOUT=10.0
