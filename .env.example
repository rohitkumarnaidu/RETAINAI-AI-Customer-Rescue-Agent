# RETAINAI - Environment Configuration

# Application
APP_NAME=RETAINAI
APP_ENV=development
DEBUG=true
PORT=8000

# Database Configuration (PostgreSQL / SQLite fallback for development)
DATABASE_URL=sqlite:///./retainai.db
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/retainai

# LLM / AI Configuration — Groq LPU recommended for hackathon (fast + cheap) — Gemini also supported
# Better models: groq: deepseek-r1-distill-llama-70b (best reasoning) > meta-llama/llama-4-maverick-17b-128e-instruct > llama-3.3-70b-versatile (default stable) | gemini: gemini-2.5-pro > gemini-2.5-flash
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
# For deeper reasoning: LLM_MODEL=deepseek-r1-distill-llama-70b  (or qwen/qwen3-32b)
# For Gemini: LLM_PROVIDER=gemini, LLM_MODEL=gemini-2.5-pro
LLM_API_KEY=your_llm_api_key_here  # or GROQ_API_KEY=gsk_... when provider=groq
# GROQ_API_KEY=gsk_your_groq_key_here

# API Configuration
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Application Settings
DEMO_MODE=true
LOG_LEVEL=INFO

# Auth (S39) — DEMO_MODE=true bypasses unless AUTH_ENABLED=true
# All below are 32-char demo values (hex), safe for hackathon
AUTH_ENABLED=false
AUTH_SECRET=changeme-replace-in-prod-32char-aaaa
JWT_SECRET=changeme-replace-in-prod-32char-aaaa
APP_SECRET_KEY=changeme-replace-in-prod-32char-bbbb
DEMO_API_KEY=changeme-replace-in-prod-32char-cccc
API_KEY=changeme-replace-in-prod-32char-cccc
DEMO_TENANT_ID=changeme-tenant-id-replace-in-prod
DEMO_ORG_KEY=changeme-org-key-replace-in-prod

# ChromaDB Memory (replaces Redis for semantic memory)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_API_KEY=changeme-chroma-key-replace-in-prod
CHROMA_TENANT=changeme-chroma-tenant-replace-prod
CORS_SECRET=changeme-cors-secret-replace-prod

# Timeouts
AGENT_TIMEOUT=60
LLM_TIMEOUT=10.0
